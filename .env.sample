# Google OAuth credentials
GOOGLE_ID=your_google_id_here
GOOGLE_SECRET=your_google_secret_here

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# NextAuth secret
NEXTAUTH_SECRET=your_nextauth_secret_here

# Base URL for the application
NEXTAUTH_URL=http://localhost:3000

# Google Gemini API key (server-only — never expose as NEXT_PUBLIC_*)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Tavily web search for agent mode (falls back to DuckDuckGo if unset)
TAVILY_API_KEY=your_tavily_api_key_here
